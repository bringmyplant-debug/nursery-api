// Catalogue service - the admin-owned catalogue.
//
// Ported from the monolith. Admin owns what exists and what it costs; no
// nursery ever writes here. What changed:
//
//   * No Inventory, Nursery or Order relations. Stock lives in the inventory
//     service; what this service holds of it is VariantAvailability, a
//     projection fed by inventory.availability.changed.v1.
//   * No Outbox: this service announces nothing yet. It only consumes.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A table rather than an enum: adding "Aquatic Plants" should be an
/// admin action, not a migration and a deploy.
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(120)
  blurb     String?  @db.VarChar(300)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plants Plant[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

enum LightNeed {
  LOW
  BRIGHT_INDIRECT
  FULL_SUN
}

enum WaterNeed {
  LOW
  MODERATE
  HIGH
}

enum Difficulty {
  EASY
  MODERATE
  EXPERT
}

enum Placement {
  INDOOR
  OUTDOOR
  BOTH
}

/// Peak season, in the vocabulary of the catalogue intake sheet.
/// Editorial rather than derived: two plants with the same light and
/// water profile can still peak in different months.
enum Season {
  SUMMER
  WINTER
  MONSOON
  ALL_SEASON
}

enum PlantStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// The canonical entry. A nursery can never create one of these — if it
/// could, the same monstera would exist fourteen times at fourteen
/// different prices, and the single price the buyer is promised would be
/// a fiction.
model Plant {
  id            String      @id @default(uuid()) @db.Uuid
  slug          String      @unique @db.VarChar(120)
  commonName    String      @db.VarChar(160)
  botanicalName String      @db.VarChar(160)
  family        String?     @db.VarChar(120)
  categoryId    String      @db.Uuid
  status        PlantStatus @default(DRAFT)

  summary     String  @db.VarChar(320)
  description String  @db.Text

  // Care profile. Columns rather than a JSON blob because every one of
  // these is a storefront filter.
  lightNeed       LightNeed
  waterNeed       WaterNeed
  waterEveryDays  Int
  humidity        String?   @db.VarChar(120)
  temperature     String?   @db.VarChar(120)
  soil            String?   @db.VarChar(200)
  fertiliser      String?   @db.VarChar(200)

  // Traits — also filters, and petSafe drives a safety notice.
  petSafe        Boolean @default(false)
  airPurifying   Boolean @default(false)
  lowMaintenance Boolean @default(false)
  flowering      Boolean @default(false)
  placement      Placement @default(INDOOR)

  difficulty Difficulty
  season     Season     @default(ALL_SEASON)
  matureSize String?    @db.VarChar(120)
  growthRate String?    @db.VarChar(60)
  tags       String[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      PlantImage[]
  variants    PlantVariant[]
  collections CollectionPlant[]

  @@index([status, publishedAt])
  @@index([status, season])
  @@index([categoryId])
  @@index([lightNeed])
  @@index([difficulty])
  @@index([petSafe])
  @@index([tags], type: Gin)
  @@map("plants")
}

model PlantImage {
  id        String   @id @default(uuid()) @db.Uuid
  plantId   String   @db.Uuid
  url       String   @db.VarChar(600)
  alt       String?  @db.VarChar(300)
  credit    String?  @db.VarChar(200)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId, sortOrder])
  @@map("plant_images")
}

/// Editorial groupings ("Safe Around Pets"). Membership is explicit rather
/// than a stored predicate: editors need to be able to pull one plant out
/// of a collection without rewriting a rule.
model Collection {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(80)
  title       String   @db.VarChar(160)
  tagline     String?  @db.VarChar(200)
  description String?  @db.Text
  imageUrl    String?  @db.VarChar(600)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plants CollectionPlant[]

  @@index([isActive, sortOrder])
  @@map("collections")
}

model CollectionPlant {
  collectionId String   @db.Uuid
  plantId      String   @db.Uuid
  sortOrder    Int      @default(0)
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  plant      Plant      @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@id([collectionId, plantId])
  @@index([plantId])
  @@map("collection_plants")
}

/// A sellable SKU: one plant in one size, priced by admin.
///
/// This is where the model changed shape. Previously each nursery set its
/// own price and the storefront compared them; now admin owns price and a
/// nursery may only hold stock against it. Price therefore lives here, on
/// something admin controls, and never on a nursery-owned row.
model PlantVariant {
  id      String @id @default(uuid()) @db.Uuid
  plantId String @db.Uuid

  /// Stable, human-readable SKU. Printed on invoices and quoted in support,
  /// so it must not change when the label or price does.
  sku   String @unique @db.VarChar(40)
  /// What the buyer picks between, e.g. `6" pot`.
  label String @db.VarChar(60)

  potSize     String  @db.VarChar(20)
  potMaterial String? @db.VarChar(60)
  heightCm    Int?

  /// The national reference price in integer paise. NOT what anybody is
  /// charged: a VariantCityPrice row overrides it per market, and the
  /// storefront resolves one before it will show a number at all. Kept
  /// here as the fallback so a newly published SKU is sellable the moment
  /// it exists, rather than only in the cities somebody remembered to
  /// price it in.
  ///
  /// Integer paise, always. Float rupees drift, and a shop that charges a
  /// different number than it displayed loses the customer once and the
  /// chargeback dispute twice.
  basePricePaise Int
  /// Struck-through reference price, also pre-override.
  baseMrpPaise   Int?

  /// GST. Live plants (HSN 0602) and planters (HSN 3924/6914) are not
  /// taxed alike, so the rate belongs to the SKU rather than a constant
  /// somewhere in the pricing code. Basis points: 500 = 5%.
  hsnCode    String? @db.VarChar(12)
  taxRateBps Int     @default(0)

  /// Billable weight, used by distance banding for heavier consignments.
  weightGrams Int?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plant       Plant              @relation(fields: [plantId], references: [id], onDelete: Cascade)
  cityPrices  VariantCityPrice[]

  @@unique([plantId, potSize])
  @@index([plantId, isActive])
  @@index([basePricePaise])
  @@map("plant_variants")
}

/// What one SKU costs in one city.
///
/// Price stopped being a property of a SKU when it became clear the same
/// plant does not cost the same to keep alive everywhere: a fern wants
/// humidity it will not get through a Delhi April, and a succulent wants
/// dryness it will not get through a Mumbai July. A single national price
/// would either underpay partners in the hard markets or overcharge
/// buyers in the easy ones.
///
/// A row here overrides PlantVariant.basePricePaise for that city. Absent
/// rows fall back to the base, so a city is never *un*sellable merely
/// because nobody has priced it yet.
///
/// `city` is a plain string matching Nursery.city rather than a foreign
/// key: cities are a short, slow-moving list held in the application
/// (apps/web/src/lib/city.ts), and a table here would need seeding,
/// joining and keeping in step for no gain.
model VariantCityPrice {
  id        String @id @default(uuid()) @db.Uuid
  variantId String @db.Uuid
  city      String @db.VarChar(80)

  pricePaise Int
  mrpPaise   Int?

  /// Why this city differs, for the admin screen. An unexplained override
  /// is one somebody eventually "corrects" back to the base.
  note String? @db.VarChar(200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant PlantVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, city])
  @@index([city])
  @@map("variant_city_prices")
}

/// Buyable quantity of one variant in one city: the inventory service's
/// announcement, stored verbatim. The storefront reads stock from here
/// instead of joining nurseries, subscriptions and inventory on every page.
///
/// An absent row means zero. `version` is inventory's own, per (variant,
/// city); an event is applied only if newer than the row held.
model VariantAvailability {
  variantId String   @db.Uuid
  city      String   @db.VarChar(80)
  available Int
  holders   Int
  version   Int
  updatedAt DateTime @default(now()) @updatedAt

  @@id([variantId, city])
  @@index([city])
  @@map("variant_availability")
}

/// Which events each consumer has already applied. Written in the same
/// transaction as the handler's own changes.
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@index([processedAt])
  @@map("processed_events")
}

/// Events a consumer gave up on after repeated failure. Needs a human.
model DeadLetter {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consumer   String
  eventId    String    @map("event_id") @db.Uuid
  type       String
  payload    Json      @db.JsonB
  error      String
  attempts   Int
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([resolvedAt])
  @@map("dead_letters")
}
