// Inventory service — how much of each variant each nursery holds, and the
// per-city totals derived from it.
//
// Ported from the monolith's `Inventory` model. What changed:
//
//   * `nurseryId` and `variantId` are plain ids, not foreign keys. The
//     nursery lives in the partner service and the variant in catalogue;
//     neither table exists in this database.
//   * Whether a nursery may currently sell arrives as an event and is kept
//     in NurseryProjection. This service never sees a subscription.
//   * Availability — the sum a buyer sees — is computed here and pushed to
//     catalogue as an event, instead of being recomputed by a join on
//     every page view.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OfferCondition {
  PREMIUM
  STANDARD
  NURSERY_FRESH
}

/// How much of a variant one nursery is holding.
///
/// Deliberately carries no price: a nursery's only lever is quantity.
/// The migration adds CHECK (stock >= 0 AND reserved >= 0 AND reserved <=
/// stock) — available stock can never go negative, whatever the caller does.
model Inventory {
  id        String @id @default(uuid()) @db.Uuid
  nurseryId String @db.Uuid
  variantId String @db.Uuid

  /// On hand, including anything currently reserved.
  stock Int @default(0)
  /// Committed to unpaid orders. Available = stock - reserved.
  reserved Int @default(0)

  condition OfferCondition @default(STANDARD)
  isActive  Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nurseryId, variantId])
  @@index([variantId, isActive])
  @@index([nurseryId, isActive])
  @@map("inventory")
}

/// This service's copy of "may this nursery sell, and where", fed by the
/// partner service's `partner.sellability.changed.v1`.
///
/// `version` is the partner's, copied verbatim. An event is applied only if
/// it is newer than what is held here, so redelivery and reordering are
/// harmless.
model NurseryProjection {
  nurseryId String   @id @db.Uuid
  city      String   @db.VarChar(80)
  sellable  Boolean
  version   Int
  updatedAt DateTime @default(now()) @updatedAt

  @@index([city, sellable])
  @@map("nursery_projection")
}

/// Buyable quantity of one variant in one city: the sum over sellable
/// nurseries there, net of reservations. What catalogue is told.
///
/// `version` is this service's own, per (variant, city).
model Availability {
  variantId String   @db.Uuid
  city      String   @db.VarChar(80)
  available Int
  holders   Int
  version   Int
  updatedAt DateTime @default(now()) @updatedAt

  @@id([variantId, city])
  @@map("availability")
}

model Outbox {
  id          String    @id @db.Uuid
  seq         BigInt    @unique @default(autoincrement())
  type        String
  payload     Json      @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@map("outbox")
}

/// Which events each consumer has already applied. Written in the same
/// transaction as the handler's own changes.
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@index([processedAt])
  @@map("processed_events")
}

/// Events a consumer gave up on after repeated failure. Needs a human.
model DeadLetter {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consumer   String
  eventId    String    @map("event_id") @db.Uuid
  type       String
  payload    Json      @db.JsonB
  error      String
  attempts   Int
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([resolvedAt])
  @@map("dead_letters")
}
