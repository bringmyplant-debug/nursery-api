NODE_ENV=development
PORT=4104
DATABASE_URL=postgresql://svc_identity:identity_dev@localhost:5434/nursery_identity?schema=public
SHADOW_DATABASE_URL=postgresql://svc_identity:identity_dev@localhost:5434/nursery_identity_shadow?schema=public
NATS_URL=nats://localhost:4222
INTERNAL_API_TOKEN=dev-internal-token-change-me

# Created by `node scripts/generate-jwt-keys.js` at the repo root. Only this
# service has the private key; everyone else gets the public one.
JWT_PRIVATE_KEY_PATH=../../.keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../../.keys/jwt-public.pem
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# A refresh token rotated this recently is treated as a concurrent request
# (409), not as theft. Older than this, presenting it revokes the session.
REFRESH_REUSE_GRACE_SECONDS=10

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_MAX_PER_PHONE_PER_HOUR=5
# Keys the hash of each code. Dev-only value; production refuses to boot with it.
OTP_PEPPER=dev-only-otp-pepper-change-me-0123456789
SIGNUP_TOKEN_TTL_SECONDS=600

# console: prints the code to this service's log. Dev only; production refuses it.
SMS_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
